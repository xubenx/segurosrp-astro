---
interface Props {
  title?: string;
}

const { title = 'Sistema de blog' } = Astro.props;
---

<div class="min-h-screen bg-slate-100 text-slate-800">
  <header class="bg-rp-blue text-white">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
      <div>
        <a href="/sistema" class="font-bold text-lg">Sistema SegurosRP</a>
        <p class="text-blue-200 text-sm">{title}</p>
      </div>
      <nav class="flex items-center gap-3 text-sm">
        <a href="/sistema" class="hover:text-rp-orange">Artículos</a>
        <a href="/sistema/nuevo" class="hover:text-rp-orange">Nuevo</a>
        <a href="/blog/plantillas" class="hover:text-rp-orange" target="_blank" rel="noopener">Plantillas</a>
        <a href="/blog" class="hover:text-rp-orange" target="_blank" rel="noopener">Ver blog</a>
        <form method="post" action="/api/sistema/logout">
          <button class="bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-md" type="submit">Salir</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="max-w-6xl mx-auto px-4 py-8">
    <slot />
  </main>
</div>
