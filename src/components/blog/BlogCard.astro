---
import { formatDate, type BlogPost } from '../../lib/blog';

interface Props {
  post: Pick<BlogPost, 'slug' | 'title' | 'description' | 'coverImage' | 'coverAlt' | 'category' | 'publishedAt'>;
  href?: string;
}

const { post, href = `/blog/${post.slug}` } = Astro.props;
---

<article class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
  <a href={href} class="block">
    <img
      src={post.coverImage}
      alt={post.coverAlt || post.title}
      class="w-full h-48 object-cover"
      loading="lazy"
      width="400"
      height="250"
    />
  </a>
  <div class="p-4 md:p-6 flex flex-col flex-1">
    <p class="text-rp-orange text-xs font-semibold uppercase tracking-wide mb-2">{post.category}</p>
    <h3 class="text-lg md:text-xl font-semibold text-rp-blue mb-3">
      <a href={href} class="hover:text-rp-orange transition">{post.title}</a>
    </h3>
    <p class="text-gray-600 mb-4 text-sm md:text-base flex-1">{post.description}</p>
    <div class="flex items-center justify-between">
      <time class="text-xs text-gray-400" datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      <a href={href} class="text-rp-orange hover:text-orange-600 font-semibold text-sm">Leer más</a>
    </div>
  </div>
</article>
