---
import type { FaqItem } from '../lib/faq-schema';

interface Props {
  title?: string;
  intro?: string;
  items: FaqItem[];
}

const {
  title = 'Preguntas frecuentes',
  intro,
  items,
} = Astro.props;
---

<section id="preguntas-frecuentes" class="py-16 bg-gray-50" aria-labelledby="faq-heading">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 id="faq-heading" class="text-3xl lg:text-4xl font-bold text-rp-blue mb-4">{title}</h2>
      {intro && <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">{intro}</p>}
    </div>
    <div class="max-w-4xl mx-auto space-y-4">
      {items.map((item) => (
        <article class="bg-white rounded-2xl p-6 shadow-lg">
          <h3 class="text-lg font-semibold text-rp-blue">{item.question}</h3>
          <p class="mt-3 text-gray-700 leading-relaxed">{item.answer}</p>
        </article>
      ))}
    </div>
  </div>
</section>
