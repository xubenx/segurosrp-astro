---
import { getPublishedPosts } from '../lib/blog-collection';
import BlogCard from './blog/BlogCard.astro';

const posts = (await getPublishedPosts()).slice(0, 3);
---

<section id="blog" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center mb-12">
      <h2 class="text-4xl font-bold text-rp-blue">Temas de interés</h2>
      <a href="/blog" class="text-rp-orange hover:text-orange-600 font-semibold">Ver más</a>
    </div>

    {posts.length === 0 ? (
      <p class="text-gray-600">Pronto publicaremos guías de seguros de vida, salud y retiro.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    )}
  </div>
</section>
