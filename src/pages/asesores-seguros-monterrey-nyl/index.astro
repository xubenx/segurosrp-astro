---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DiagnosticoLead from '../../components/DiagnosticoLead.astro';
import { Image } from 'astro:assets';

// SEO optimizado para SEM Google Ads
const title = 'Asesores Seguros Monterrey - New York Life | Seguros RP';
const description = 'Asesores especializados en seguros Monterrey New York Life. Protección de vida, salud y patrimonio. Cotiza gratis con expertos certificados en seguros.';

// Palabras clave para tracking
const keywords = 'asesores seguros monterrey, seguros monterrey asesores, new york life monterrey, seguros vida monterrey, asesores seguros new york life';
---

<Layout title={title} description={description}>
	<Header />
	
	<!-- Hero Section completamente responsivo -->
	<section class="min-h-screen bg-gradient-to-r from-rp-blue to-rp-light-blue text-white relative overflow-hidden">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-screen">
			
			<!-- Layout Unificado Responsivo -->
			<div class="flex flex-col lg:flex-row items-center justify-center lg:justify-between h-full py-8 lg:py-0 relative z-20">
				
				<!-- Contenido Principal -->
				<div class="flex flex-col justify-center w-full lg:w-1/2 text-center lg:text-left mb-8 lg:mb-0">
					<!-- Título responsivo -->
					<h1 class="text-3xl mt-40 md:mt-20 sm:text-4xl md:text-5xl lg:text-6xl xl:text-5xl font-bold leading-tight ">
						<span class="text-rp-orange block sm:inline">Asesores Seguros</span>
						<span class="text-white block">Monterrey New York Life</span>
					</h1>
					
					<!-- Descripción responsiva -->
					<p class="text-lg sm:text-xl md:text-2xl mb-6  text-blue-100 max-w-2xl mx-auto lg:mx-0">
						Protege a tu familia con los mejores seguros de vida, salud y educación en Seguros Monterrey
					</p>
					
					<!-- Beneficios - Ocultos en móvil pequeño, visibles en tablet+ -->
					<div class="hidden sm:block p-4 md:p-6 mb-6 max-w-2xl mx-auto lg:mx-0">
						<h2 class="text-xl md:text-2xl font-semibold mb-3 text-rp-orange">Beneficios Exclusivos</h2>
						<ul class="space-y-2 md:space-y-3 text-base md:text-lg">
							<li class="flex items-center justify-center lg:justify-start">
								<span class="text-rp-orange mr-3">✓</span>
								Asesores certificados New York Life
							</li>
							<li class="flex items-center justify-center lg:justify-start">
								<span class="text-rp-orange mr-3">✓</span>
								Cotización gratuita sin compromiso
							</li>
							<li class="flex items-center justify-center lg:justify-start">
								<span class="text-rp-orange mr-3">✓</span>
								Atención personalizada en todo México
							</li>
							<li class="flex items-center justify-center lg:justify-start">
								<span class="text-rp-orange mr-3">✓</span>
								Planes adaptados a tu presupuesto
							</li>
						</ul>
					</div>
					
					<!-- Botones responsivos -->
					<div class="flex flex-col sm:flex-row gap-3 md:gap-4 items-center justify-center lg:justify-start max-w-lg mx-auto lg:mx-0">
						<a href="#contacto" class="w-full sm:w-auto bg-rp-orange hover:bg-orange-600 text-white px-6 md:px-8 py-3 md:py-4 rounded-full text-base md:text-lg font-semibold text-center transition duration-300 shadow-lg hover:shadow-xl transform hover:scale-105">
							Cotizar Ahora GRATIS
						</a>
						<a href="#contacto" class="w-full sm:w-auto bg-white text-rp-blue px-6 md:px-8 py-3 md:py-4 rounded-full text-base md:text-lg font-semibold text-center transition duration-300 hover:bg-rp-orange hover:text-white shadow-lg hover:shadow-xl transform hover:scale-105">
							📞 Llamar Asesor
						</a>
					</div>
				</div>
				
				<!-- Imagen Principal - Responsiva -->
				<div class="w-full lg:w-1/2 h-96  sm:h-80 md:h-96 lg:h-full flex items-center justify-center relative">
					<!-- Móvil y Tablet -->
					<div class="lg:hidden w-full h-full relative  mt-40">
						<Image 
							src="/principal.webp" 
							alt="Asesores Seguros Monterrey New York Life - Familia protegida con seguros de vida, salud y educación"
							class="w-full h-full object-contain object-center" 
							loading="eager"
							fetchpriority="high"
							width={400}
							height={350}
							format="webp"
							sizes="(max-width: 768px) 400px, (max-width: 1024px) 600px, 800px"
						/>
					</div>
					
					<!-- Desktop -->
					<div class="hidden lg:flex w-full h-full items-end justify-center">
						<Image 
							src="/principal.webp" 
							alt="Asesores Seguros Monterrey New York Life - Familia protegida con seguros de vida, salud y educación"
							class="w-full h-auto max-h-full object-contain object-bottom" 
							loading="eager"
							fetchpriority="high"
							width={800}
							height={600}
							format="webp"
							sizes="(min-width: 1024px) 800px, 600px"
						/>
					</div>
				</div>
			</div>
			
			<!-- Overlay decorativo para móviles pequeños -->
			<div class="sm:hidden absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent z-10 pointer-events-none"></div>
		</div>
	</section>

	<!-- Sección de Servicios -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-bold text-rp-blue mb-4">
					Seguros Monterrey New York Life con Asesores Expertos
				</h2>
				<p class="text-xl text-gray-600 max-w-3xl mx-auto">
					Nuestros asesores especializados en Seguros Monterrey te ayudan a encontrar la protección perfecta para ti y tu familia
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				<!-- Seguros de Vida -->
				<div class="bg-white rounded-xl shadow-lg p-8 text-center hover:shadow-xl transition duration-300">
					<div class="w-16 h-16 bg-rp-orange rounded-full flex items-center justify-center mx-auto mb-6">
						<span class="text-2xl text-white" role="img" aria-label="Protección familiar">💝</span>
					</div>
					<h3 class="text-2xl font-bold text-rp-blue mb-4">Seguros de Vida</h3>
					<p class="text-gray-600 mb-6">Protección completa para tu familia con los mejores planes de New York Life</p>
					<ul class="text-left space-y-2 text-gray-700">
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Vida temporal</span></li>
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Vida permanente</span></li>
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Vida universal</span></li>
					</ul>
				</div>

				<!-- Seguros de Salud -->
				<div class="bg-white rounded-xl shadow-lg p-8 text-center hover:shadow-xl transition duration-300">
					<div class="w-16 h-16 bg-rp-orange rounded-full flex items-center justify-center mx-auto mb-6">
						<span class="text-2xl text-white" role="img" aria-label="Salud médica">🏥</span>
					</div>
					<h3 class="text-2xl font-bold text-rp-blue mb-4">Seguros de Salud</h3>
					<p class="text-gray-600 mb-6">Atención médica de calidad con la mejor cobertura en Seguros Monterrey</p>
					<ul class="text-left space-y-2 text-gray-700">
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Gastos médicos mayores</span></li>
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Accidentes personales</span></li>
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Enfermedades graves</span></li>
					</ul>
				</div>

				<!-- Seguros Educativos -->
				<div class="bg-white rounded-xl shadow-lg p-8 text-center hover:shadow-xl transition duration-300">
					<div class="w-16 h-16 bg-rp-orange rounded-full flex items-center justify-center mx-auto mb-6">
						<span class="text-2xl text-white" role="img" aria-label="Educación">🎓</span>
					</div>
					<h3 class="text-2xl font-bold text-rp-blue mb-4">Seguros Educativos</h3>
					<p class="text-gray-600 mb-6">Asegura el futuro educativo de tus hijos desde hoy</p>
					<ul class="text-left space-y-2 text-gray-700">
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Planes de ahorro educativo</span></li>
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Seguro universitario</span></li>
						<li class="flex items-center"><span class="text-rp-orange mr-2" aria-hidden="true">✓</span> <span>Protección para estudios</span></li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Sección de Asesores -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-bold text-rp-blue mb-4">
					Conoce a Nuestros Asesores en Seguros Monterrey
				</h2>
				<p class="text-xl text-gray-600">
					Expertos certificados con años de experiencia en seguros New York Life
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-white rounded-xl shadow-lg p-8 text-center">
					<Image 
						src="/asesor_1.webp" 
						alt="Lic. Silvia Plascencia - Especialista en Protección Familiar y Seguros de Vida en Seguros Monterrey" 
						class="w-32 h-32 rounded-full mx-auto mb-6 object-cover"
						width={128}
						height={128}
						format="webp"
						sizes="(max-width: 768px) 128px, (max-width: 1024px) 150px, 128px"
					/>
					<h3 class="text-2xl font-bold text-rp-blue mb-2">Lic. Silvia Plascencia</h3>
					<p class="text-rp-orange font-bold mb-4">Especialista en Protección Familiar</p>
					<p class="text-gray-600 mb-6">+29 años de experiencia ayudando a familias de México a proteger su futuro</p>
					<a href="#contacto" class="bg-rp-orange hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition duration-300" aria-label="Contactar a Silvia Plascencia por teléfono">
						Contactar Asesor
					</a>
				</div>

				<div class="bg-white rounded-xl shadow-lg p-8 text-center">
					<Image 
						src="/asesor_2.webp" 
						alt="Lic. Michelle Ramírez - Especialista en Seguros Educativos y Planificación Financiera en Seguros Monterrey" 
						class="w-32 h-32 rounded-full mx-auto mb-6 object-cover"
						width={128}
						height={128}
						format="webp"
						sizes="(max-width: 768px) 128px, (max-width: 1024px) 150px, 128px"
					/>
					<h3 class="text-2xl font-bold text-rp-blue mb-2">Lic. Michelle Ramírez Plascencia</h3>
					<p class="text-rp-orange font-bold mb-4">Especialista en Seguros Educativos</p>
					<p class="text-gray-600 mb-6">Experta en planificación financiera y seguros educativos para el futuro de tus hijos</p>
					<a href="#contacto" class="bg-rp-orange hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition duration-300" aria-label="Contactar a Michelle Ramírez por teléfono">
						Contactar Asesor
					</a>
				</div>

				<div class="bg-white rounded-xl shadow-lg p-8 text-center">
					<Image 
						src="/asesor_3.webp" 
						alt="Lic. José Ramírez - Especialista en Retiro y Patrimonio, Planes de Pensión en Seguros Monterrey" 
						class="w-32 h-32 rounded-full mx-auto mb-6 object-cover"
						width={128}
						height={128}
						format="webp"
						sizes="(max-width: 768px) 128px, (max-width: 1024px) 150px, 128px"
					/>
					<h3 class="text-2xl font-bold text-rp-blue mb-2">Lic. José Ramírez</h3>
					<p class="text-rp-orange font-bold mb-4">Especialista en Retiro y Patrimonio</p>
					<p class="text-gray-600 mb-6">+29 años siendo consultor en planificación de retiro y protección patrimonial</p>
                    
					<a href="#contacto" class="bg-rp-orange hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition duration-300" aria-label="Contactar a José Ramírez por teléfono">
						Contactar Asesor
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Formulario de Cotización optimizado para conversión -->
	<section id="cotizar" class="py-16 bg-rp-blue">
		<div class="container mx-auto px-4">
			<div class="max-w-5xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-4xl font-bold text-white mb-4">
						Cotiza tu Seguro GRATIS en Seguros Monterrey
					</h2>
					<p class="text-xl text-blue-100">
						Recibe una cotización personalizada sin compromiso de nuestros asesores expertos
					</p>
				</div>
				
				<!-- Beneficios - Horizontal en desktop, vertical en móvil -->
				<div class="text-white mb-8 lg:mb-12">
					<h3 class="text-2xl font-bold mb-6 text-rp-orange text-center">¿Por qué elegir New York Life?</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						<div class="flex items-start md:flex-col md:items-center md:text-center">
							<span class="text-rp-orange text-3xl mr-4 md:mr-0 md:mb-3" role="img" aria-label="Trofeo de excelencia">🏆</span>
							<div>
								<h4 class="font-bold text-lg mb-1 md:mb-2">175+ Años de Experiencia</h4>
								<p class="text-blue-100 text-sm md:text-base">Líder mundial en seguros de vida con presencia en más de 100 países</p>
							</div>
						</div>
						<div class="flex items-start md:flex-col md:items-center md:text-center">
							<span class="text-rp-orange text-3xl mr-4 md:mr-0 md:mb-3" role="img" aria-label="Solidez financiera">💰</span>
							<div>
								<h4 class="font-bold text-lg mb-1 md:mb-2">Solidez Financiera</h4>
								<p class="text-blue-100 text-sm md:text-base">Calificación AAA por las principales agencias calificadoras</p>
							</div>
						</div>
						<div class="flex items-start md:flex-col md:items-center md:text-center">
							<span class="text-rp-orange text-3xl mr-4 md:mr-0 md:mb-3" role="img" aria-label="Atención al cliente">👥</span>
							<div>
								<h4 class="font-bold text-lg mb-1 md:mb-2">Atención Personalizada</h4>
								<p class="text-blue-100 text-sm md:text-base">Asesores locales en Seguros Monterrey con atención 24/7</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Formulario - Ancho completo -->
				<div class="bg-white rounded-xl shadow-2xl p-6 lg:p-8">
					<DiagnosticoLead
						source="Landing Asesores Monterrey NYL"
						campaign="SEM Google Ads - Asesores Seguros Monterrey"
						trackingEvent="asesores_form"
						heading="Cotización personalizada"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonios -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-bold text-rp-blue mb-4">
					Lo que dicen nuestros clientes en Seguros Monterrey
				</h2>
				<p class="text-xl text-gray-600">
					Más de 1,000 familias protegidas confían en nuestros asesores
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-gray-50 rounded-xl p-8">
					<div class="flex items-center mb-4">
						<div class="text-rp-orange text-2xl" role="img" aria-label="Calificación 5 estrellas">⭐⭐⭐⭐⭐</div>
					</div>
					<p class="text-gray-700 mb-6 italic">"Excelente servicio. Mi asesor me explicó todo muy bien y encontré el seguro perfecto para mi familia. Muy recomendado."</p>
					<div class="flex items-center">
						<div class="w-12 h-12 bg-rp-blue rounded-full flex items-center justify-center text-white font-bold mr-4" aria-label="Iniciales del cliente">
							MG
						</div>
						<div>
							<p class="font-bold text-rp-blue">María González</p>
							<p class="text-gray-600">Cliente desde 2022</p>
						</div>
					</div>
				</div>

				<div class="bg-gray-50 rounded-xl p-8">
					<div class="flex items-center mb-4">
						<div class="text-rp-orange text-2xl" role="img" aria-label="Calificación 5 estrellas">⭐⭐⭐⭐⭐</div>
					</div>
					<p class="text-gray-700 mb-6 italic">"Los asesores de New York Life son muy profesionales. Me ayudaron a planificar mi retiro y estoy muy satisfecho."</p>
					<div class="flex items-center">
						<div class="w-12 h-12 bg-rp-blue rounded-full flex items-center justify-center text-white font-bold mr-4" aria-label="Iniciales del cliente">
							JL
						</div>
						<div>
							<p class="font-bold text-rp-blue">Juan López</p>
							<p class="text-gray-600">Cliente desde 2020</p>
						</div>
					</div>
				</div>

				<div class="bg-gray-50 rounded-xl p-8">
					<div class="flex items-center mb-4">
						<div class="text-rp-orange text-2xl" role="img" aria-label="Calificación 5 estrellas">⭐⭐⭐⭐⭐</div>
					</div>
					<p class="text-gray-700 mb-6 italic">"Rápida atención, cotización inmediata y el mejor precio. Mi asesor siempre está disponible cuando lo necesito."</p>
					<div class="flex items-center">
						<div class="w-12 h-12 bg-rp-blue rounded-full flex items-center justify-center text-white font-bold mr-4" aria-label="Iniciales del cliente">
							AR
						</div>
						<div>
							<p class="font-bold text-rp-blue">Ana Rodríguez</p>
							<p class="text-gray-600">Cliente desde 2023</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Final -->
	<section id="contacto" class="py-16 bg-gradient-to-r from-rp-orange to-orange-600">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-4xl font-bold text-white mb-6">
				¿Listo para proteger a tu familia?
			</h2>
			<p class="text-xl text-orange-100 mb-8 max-w-2xl mx-auto">
				Nuestros asesores especializados en Seguros Monterrey están listos para ayudarte a encontrar el seguro perfecto
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#contacto" class="bg-white hover:bg-gray-100 text-rp-orange px-8 py-4 rounded-lg text-lg font-bold transition duration-300 shadow-lg">
					Cotizar Ahora
				</a>
				<a href="#contacto" class="bg-rp-blue hover:bg-blue-800 text-white px-8 py-4 rounded-lg text-lg font-bold transition duration-300 shadow-lg">
					📞 (44) 6135-4113
				</a>
			</div>
		</div>
	</section>

	<Footer />

	<!-- Agregar estilos de accesibilidad -->
	<style>
		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
	</style>

	<!-- Schema.org structured data for SEO -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "InsuranceAgency",
		"name": "SegurosRP — Ramírez & Plascencia, Asesores Seguros Monterrey New York Life",
		"description": "Despacho de asesores certificados de Seguros Monterrey New York Life. Especialistas en seguro de vida, gastos médicos, retiro y educación. Atención nacional.",
		"url": "https://segurosrp.com/asesores-seguros-monterrey-nyl",
		"telephone": "+52-446-135-4113",
		"email": "info@segurosrp.com",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "Nouvalia, Local 106 Planta Baja, Piso 6",
			"addressLocality": "Santiago de Querétaro",
			"addressRegion": "Querétaro",
			"postalCode": "76090",
			"addressCountry": "MX"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": "20.5888",
			"longitude": "-100.3899"
		},
		"openingHours": "Mo-Fr 09:00-18:00",
		"areaServed": "México",
		"sameAs": [
			"https://www.facebook.com/segurosrp/",
			"https://www.linkedin.com/company/ramirez-plascencia-despacho-de-seguros/",
			"https://www.instagram.com/ramirezplascencia_/"
		],
		"offers": {
			"@type": "Offer",
			"description": "Asesoría y cotización gratuita de seguros Monterrey New York Life",
			"price": "0",
			"priceCurrency": "MXN"
		}
	}
	</script>

	<Fragment slot="head">
		<meta name="keywords" content={keywords}>
		<link rel="alternate" hreflang="es-mx" href="https://segurosrp.com/asesores-seguros-monterrey-nyl/">
	</Fragment>
</Layout>