---
import Layout from '../../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error');
---

<Layout title="Entrar al sistema | SegurosRP" noindex={true} minimal={true}>
  <main class="min-h-screen bg-rp-blue flex items-center justify-center px-4">
    <form
      method="post"
      action="/api/sistema/login"
      class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md"
    >
      <h1 class="text-2xl font-bold text-rp-blue mb-1">Ramirez y Plascencia</h1>
      <p class="text-gray-500 text-sm mb-6">Inicio de sesión</p>
      {error && (
        <p class="mb-4 text-sm text-red-700 bg-red-50 border border-red-100 rounded-lg px-3 py-2">
          {error === 'credenciales' ? 'Usuario o contraseña incorrectos.' : 'No se pudo iniciar sesión. Revisa SISTEMA_USER y SISTEMA_PASSWORD.'}
        </p>
      )}
      <label class="block mb-4">
        <span class="text-sm font-semibold">Usuario</span>
        <input name="user" required autocomplete="username" class="mt-1 w-full border rounded-lg px-3 py-2" />
      </label>
      <label class="block mb-6">
        <span class="text-sm font-semibold">Contraseña</span>
        <input name="password" type="password" required autocomplete="current-password" class="mt-1 w-full border rounded-lg px-3 py-2" />
      </label>
      <button class="w-full bg-rp-orange text-white font-semibold py-3 rounded-full hover:bg-orange-600">
        Entrar
      </button>
    </form>
  </main>
</Layout>
