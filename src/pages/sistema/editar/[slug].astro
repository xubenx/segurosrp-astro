---
import Layout from '../../../layouts/Layout.astro';
import SistemaShell from '../../../components/sistema/SistemaShell.astro';
import PostForm from '../../../components/sistema/PostForm.astro';
import { getPost } from '../../../lib/github-content';

const { slug } = Astro.params;
const post = slug ? await getPost(slug) : null;

if (!post) {
  return Astro.redirect('/sistema');
}
---

<Layout title={`Editar: ${post.title}`} noindex={true} minimal={true}>
  <SistemaShell title="Editar artículo" wide>
    <PostForm post={post} />
  </SistemaShell>
</Layout>
