---
import Layout from '../../../layouts/Layout.astro';
import SistemaShell from '../../../components/sistema/SistemaShell.astro';
import {
  computeLeadStats,
  filterLeads,
  formatLeadDate,
  LEAD_STATUSES,
  LEAD_TYPES,
  STATUS_LABEL,
  TYPE_LABEL,
  whatsappHref,
  type Lead,
} from '../../../lib/leads';
import { listLeads } from '../../../lib/leads-store';

const params = Astro.url.searchParams;
const query = {
  q: params.get('q') || '',
  status: params.get('status') || 'todos',
  perfil: params.get('perfil') || 'todos',
  type: params.get('type') || 'todos',
};

let loadError = '';
let leads: Lead[] = [];
try {
  leads = await listLeads();
} catch (error) {
  loadError = error instanceof Error ? error.message : 'No se pudieron cargar los leads';
}

const filtered = filterLeads(leads, query);
const stats = computeLeadStats(leads);
const statusClass: Record<string, string> = {
  nuevo: 'bg-sky-100 text-sky-800',
  contactado: 'bg-amber-100 text-amber-800',
  seguimiento: 'bg-orange-100 text-orange-800',
  agendado: 'bg-violet-100 text-violet-800',
  ganado: 'bg-emerald-100 text-emerald-800',
  perdido: 'bg-slate-200 text-slate-600',
};

const perfilClass: Record<string, string> = {
  A: 'bg-rose-100 text-rose-800',
  B: 'bg-blue-100 text-blue-800',
  C: 'bg-slate-100 text-slate-600',
};
---

<Layout title="Leads | Ramirez y Plascencia" noindex={true} minimal={true}>
  <SistemaShell title="Leads y seguimiento">
    <h1 class="text-2xl font-bold text-rp-blue mb-6">Leads</h1>

    {loadError && (
      <p class="mb-4 text-sm text-red-700 bg-red-50 border border-red-100 rounded-lg px-3 py-2">{loadError}</p>
    )}
    <p id="import-msg" class="hidden mb-4 text-sm rounded-lg px-3 py-2"></p>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
      <div class="bg-white rounded-xl p-4 shadow-sm"><p class="text-xs text-gray-500">Total</p><p class="text-2xl font-bold text-rp-blue">{stats.total}</p></div>
      <div class="bg-white rounded-xl p-4 shadow-sm"><p class="text-xs text-gray-500">Nuevos</p><p class="text-2xl font-bold text-sky-700">{stats.nuevos}</p></div>
      <div class="bg-white rounded-xl p-4 shadow-sm"><p class="text-xs text-gray-500">En seguimiento</p><p class="text-2xl font-bold text-orange-600">{stats.seguimiento}</p></div>
      <div class="bg-white rounded-xl p-4 shadow-sm"><p class="text-xs text-gray-500">Perfil A</p><p class="text-2xl font-bold text-rose-600">{stats.perfilA}</p></div>
      <div class="bg-white rounded-xl p-4 shadow-sm"><p class="text-xs text-gray-500">Esta semana</p><p class="text-2xl font-bold text-rp-blue">{stats.semana}</p></div>
    </div>

    <form class="bg-white rounded-xl shadow-sm p-4 mb-6 grid grid-cols-1 md:grid-cols-5 gap-3" method="get">
      <input class="border rounded-lg px-3 py-2 md:col-span-2" name="q" value={query.q} placeholder="Buscar nombre, teléfono, correo..." />
      <select class="border rounded-lg px-3 py-2" name="status">
        <option value="todos">Todos los estados</option>
        {LEAD_STATUSES.map((status) => (
          <option value={status} selected={query.status === status}>{STATUS_LABEL[status]}</option>
        ))}
      </select>
      <select class="border rounded-lg px-3 py-2" name="perfil">
        <option value="todos">Todos los perfiles</option>
        <option value="A" selected={query.perfil === 'A'}>Perfil A</option>
        <option value="B" selected={query.perfil === 'B'}>Perfil B</option>
        <option value="C" selected={query.perfil === 'C'}>Perfil C</option>
      </select>
      <select class="border rounded-lg px-3 py-2" name="type">
        <option value="todos">Todos los orígenes</option>
        {LEAD_TYPES.map((type) => (
          <option value={type} selected={query.type === type}>{TYPE_LABEL[type]}</option>
        ))}
      </select>
      <div class="md:col-span-5 flex gap-2">
        <button class="bg-rp-orange text-white px-4 py-2 rounded-full font-semibold" type="submit">Filtrar</button>
        <a class="px-4 py-2 text-sm text-gray-600" href="/sistema/leads">Quitar filtros</a>
      </div>
    </form>

    <details class="bg-white rounded-xl shadow-sm p-4 mb-6">
      <summary class="font-semibold text-rp-blue cursor-pointer">Registrar lead manual</summary>
      <form id="manual-lead" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
        <input class="border rounded-lg px-3 py-2" name="name" required placeholder="Nombre" />
        <input class="border rounded-lg px-3 py-2" name="phone" placeholder="WhatsApp" />
        <input class="border rounded-lg px-3 py-2" name="email" type="email" placeholder="Correo" />
        <input class="border rounded-lg px-3 py-2" name="source" placeholder="Fuente" />
        <textarea class="border rounded-lg px-3 py-2 md:col-span-2" name="message" rows="2" placeholder="Nota o mensaje"></textarea>
        <button class="bg-rp-blue text-white px-4 py-2 rounded-full font-semibold w-fit" type="submit">Guardar</button>
      </form>
    </details>

    {leads.length === 0 && !loadError ? (
      <p class="text-gray-600">Aún no hay leads.</p>
    ) : filtered.length === 0 ? (
      <p class="text-gray-600">No hay leads con esos filtros.</p>
    ) : (
      <div class="overflow-x-auto bg-white rounded-xl shadow">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left">
            <tr>
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">Cliente</th>
              <th class="px-4 py-3">Perfil</th>
              <th class="px-4 py-3">Origen</th>
              <th class="px-4 py-3">Estado</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {filtered.map((lead) => (
              <tr class="border-t align-top">
                <td class="px-4 py-3 whitespace-nowrap text-gray-500">{formatLeadDate(lead.createdAt)}</td>
                <td class="px-4 py-3">
                  <a class="font-semibold text-rp-blue hover:underline" href={`/sistema/leads/${lead.id}`}>{lead.name || 'Sin nombre'}</a>
                  <div class="text-xs text-gray-500">{lead.phone || '—'}{lead.email ? ` · ${lead.email}` : ''}</div>
                  {lead.oferta && <div class="text-xs text-gray-500 mt-1">{lead.oferta}</div>}
                </td>
                <td class="px-4 py-3">
                  {lead.perfil ? (
                    <span class={`text-xs font-semibold px-2 py-1 rounded-full ${perfilClass[lead.perfil]}`}>Perfil {lead.perfil}</span>
                  ) : <span class="text-gray-400">—</span>}
                </td>
                <td class="px-4 py-3">
                  <div>{TYPE_LABEL[lead.type]}</div>
                  <div class="text-xs text-gray-500">{lead.source}</div>
                </td>
                <td class="px-4 py-3">
                  <span class={`text-xs font-semibold px-2 py-1 rounded-full ${statusClass[lead.status]}`}>{STATUS_LABEL[lead.status]}</span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap space-x-2">
                  {lead.phone && (
                    <a class="text-emerald-700 font-semibold" href={whatsappHref(lead.phone, lead.name)} target="_blank" rel="noopener">WhatsApp</a>
                  )}
                  <a class="text-rp-orange font-semibold" href={`/sistema/leads/${lead.id}`}>Abrir</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </SistemaShell>
</Layout>

<script>
  const msg = document.getElementById('import-msg') as HTMLParagraphElement | null;

  function show(text: string, ok = true) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = `mb-4 text-sm rounded-lg px-3 py-2 ${ok ? 'bg-emerald-50 text-emerald-800 border border-emerald-100' : 'bg-red-50 text-red-700 border border-red-100'}`;
  }

  document.getElementById('manual-lead')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form).entries());
    const res = await fetch('/api/sistema/leads', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const json = await res.json();
    if (!res.ok) {
      show(json.message || 'No se pudo guardar', false);
      return;
    }
    window.location.reload();
  });
</script>
