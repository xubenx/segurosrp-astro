---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Plans from '../components/Plans.astro';
import PlanesDetalle from '../components/PlanesDetalle.astro';
import LifeStages from '../components/LifeStages.astro';
import Services from '../components/Services.astro';
import Statistics from '../components/Statistics.astro';
import About from '../components/About.astro';
import Blog from '../components/Blog.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ModalAd from '../components/ModalAd.astro';
import FaqList from '../components/FaqList.astro';

const pageTitle = "Seguros Monterrey NYL | Asesores certificados en México";
const pageDescription = "Asesores independientes certificados de Seguros Monterrey New York Life. Vida, gastos médicos, retiro y educación para todo México. Cotiza sin costo.";
export const prerender = true;

const homeFaqs = [
  {
    question: '¿Qué es Seguros Monterrey New York Life?',
    answer: 'Seguros Monterrey New York Life es una de las aseguradoras de vida y salud más importantes de México, con respaldo de New York Life, una de las aseguradoras más antiguas y sólidas del mundo. Ofrece seguros de vida, gastos médicos mayores, planes de retiro y seguros educativos.',
  },
  {
    question: '¿Atienden en Querétaro y Celaya?',
    answer: 'Sí. Ramírez & Plascencia tiene oficinas físicas en Santiago de Querétaro (Nouvalia, Local 106) y en Celaya, Gto. (Av. Ferrocarril Central #709). También ofrecemos asesoría nacional por videollamada y WhatsApp al +52 446 135 4113.',
  },
  {
    question: '¿Puedo contratar un seguro a distancia?',
    answer: 'Sí. Realizamos cotización, asesoría y contratación de forma completamente digital mediante videollamada y firma digital. Atendemos clientes en todo México sin necesidad de acudir a una oficina.',
  },
  {
    question: '¿Cuánto cuesta un seguro de gastos médicos mayores?',
    answer: 'El costo de un seguro de gastos médicos mayores depende de la edad, perfil de salud, deducible elegido y suma asegurada. Nuestros planes Alfa Medical, Alfa Medical Flex y Alfa Medical Internacional se adaptan a distintos presupuestos. Contáctanos para una cotización gratuita y personalizada.',
  },
];
---


<Layout title={pageTitle} description={pageDescription} canonical="https://segurosrp.com/">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "InsuranceAgency",
        "@id": "https://segurosrp.com/#organization",
        "name": "SegurosRP — Ramírez & Plascencia",
        "description": "Despacho de asesores certificados de Seguros Monterrey New York Life. Especialistas en seguro de vida, gastos médicos mayores, plan de retiro y seguro educativo en México.",
        "url": "https://segurosrp.com",
        "telephone": "+52 446 135 4113",
        "email": "info@segurosrp.com",
        "foundingDate": "1998",
        "areaServed": "México",
        "logo": "https://segurosrp.com/logo_ryp.png",
        "sameAs": [
          "https://www.facebook.com/segurosrp/",
          "https://www.instagram.com/ramirezplascencia_/",
          "https://www.linkedin.com/company/ramirez-plascencia-despacho-de-seguros/",
          "https://www.youtube.com/channel/UCkQ6zjjpXuHfIrRS1MFFIJA"
        ],
        "location": [
          {
            "@type": "Place",
            "name": "Oficina Querétaro",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Nouvalia, Local 106 Planta Baja, Piso 6",
              "addressLocality": "Santiago de Querétaro",
              "addressRegion": "Querétaro",
              "postalCode": "76090",
              "addressCountry": "MX"
            }
          },
          {
            "@type": "Place",
            "name": "Oficina Celaya",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Av. Ferrocarril Central #709, Planta Baja, Local 22, Los Laureles",
              "addressLocality": "Celaya",
              "addressRegion": "Guanajuato",
              "postalCode": "38010",
              "addressCountry": "MX"
            }
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": homeFaqs.map((item) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <Header />
  <Hero />
  <Plans  />
  <LifeStages />
  <Statistics />
  {/*<About /> */}
  <Blog />
  <Certifications />
  <FaqList
    title="Preguntas frecuentes"
    intro="Asesores certificados de Seguros Monterrey New York Life, con atención en todo México."
    items={homeFaqs}
  />
  <Contact />
  <Footer />
</Layout>
