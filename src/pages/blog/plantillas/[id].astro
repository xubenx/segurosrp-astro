---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogArticle from '../../../components/blog/BlogArticle.astro';
import { BLOG_TEMPLATES, TEMPLATE_META, type BlogTemplate } from '../../../lib/blog';
import { TEMPLATE_PREVIEWS } from '../../../lib/blog-templates';

export function getStaticPaths() {
  return BLOG_TEMPLATES.map((id) => ({ params: { id } }));
}

export const prerender = true;

const { id } = Astro.params;
const template = id as BlogTemplate;
const post = TEMPLATE_PREVIEWS[template];
const meta = TEMPLATE_META[template];
---

<Layout
  title={`${meta.name} — plantilla de blog | SegurosRP`}
  description={meta.summary}
  noindex={true}
>
  <Header />
  <main class="pt-24 pb-16">
    <div class="container mx-auto px-4 max-w-3xl">
      <nav class="text-sm text-gray-500 mb-6">
        <a href="/blog/plantillas" class="hover:text-rp-orange">Plantillas</a>
        <span class="mx-2">/</span>
        <span>{meta.name}</span>
      </nav>
      <BlogArticle post={post} example={true} />
    </div>
  </main>
  <Footer />
</Layout>
