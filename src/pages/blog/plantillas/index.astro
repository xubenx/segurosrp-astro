---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { TEMPLATE_LIST } from '../../../lib/blog-templates';
import { SITE_URL } from '../../../lib/blog';

const pageTitle = 'Plantillas de blog | SegurosRP';
const pageDescription =
  'Seis estructuras de artículo para el blog de SegurosRP: imagen arriba, al centro, video, galería, cita y layout de revista.';
---

<Layout title={pageTitle} description={pageDescription} canonical={`${SITE_URL}/blog/plantillas`} noindex={true}>
  <Header />
  <main class="pt-24 pb-16">
    <section class="bg-rp-blue text-white py-12">
      <div class="container mx-auto px-4 max-w-4xl">
        <h1 class="text-4xl font-bold mb-3">Plantillas del blog</h1>
        <p class="text-blue-100 text-lg">
          Elige cómo se verá el artículo. Cada tarjeta abre un ejemplo con lorem ipsum. En el sistema usas la misma plantilla al publicar.
        </p>
      </div>
    </section>
    <section class="container mx-auto px-4 py-12">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {TEMPLATE_LIST.map((tpl) => (
          <a
            href={`/blog/plantillas/${tpl.id}`}
            class="bg-white rounded-xl shadow-lg overflow-hidden hover:-translate-y-1 hover:shadow-xl transition"
          >
            <img src={tpl.cover} alt="" class="h-40 w-full object-cover" />
            <div class="p-5">
              <h2 class="text-xl font-bold text-rp-blue mb-2">{tpl.name}</h2>
              <p class="text-gray-600 text-sm">{tpl.summary}</p>
              <p class="mt-3 text-rp-orange font-semibold text-sm">Ver ejemplo →</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
