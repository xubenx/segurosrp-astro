---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DiagnosticoLead from '../../components/DiagnosticoLead.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import FaqList from '../../components/FaqList.astro';
import { faqPageSchema } from '../../lib/faq-schema';
import { cnsfCredential, CONTACT_EMAIL } from '../../lib/agency-credential';

const site = 'https://segurosrp.com';
const canonical = `${site}/seguros-vida/vida-mujer`;
const pageTitle = 'Vida Mujer — Seguro de Vida para Mujer | Seguros Monterrey New York Life';
const pageDescription = 'Vida Mujer de Seguros Monterrey New York Life: fallecimiento, cáncer femenino, ahorro desde el 5.º año y anticipos. Asesoría en todo México.';

const serviceData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Vida Mujer',
  serviceType: 'Seguro de vida para la mujer',
  description: 'Seguro de Seguros Monterrey New York Life diseñado para la mujer. Incluye respaldo por fallecimiento, invalidez o pérdidas orgánicas; ahorro con entregas a partir del quinto año; coberturas por cáncer de mama, cáncer de ovario y complicaciones del embarazo; y asistencia ante diagnóstico de enfermedades graves. Garantiza el 115% de rendimiento de la suma asegurada al vencimiento.',
  url: canonical,
  areaServed: { '@type': 'Country', name: 'México' },
  provider: {
    '@type': 'InsuranceAgency',
    name: 'SegurosRP — Ramírez & Plascencia',
    url: site,
    telephone: '+52 446 135 4113',
    email: CONTACT_EMAIL,
    hasCredential: cnsfCredential,
    areaServed: 'México',
  },
  brand: { '@type': 'Brand', name: 'Seguros Monterrey New York Life' },
};

const vidaMujerFaqs = [
  {
    question: '¿Qué protege Vida Mujer?',
    answer: 'Ofrece respaldo financiero en caso de fallecimiento, invalidez o pérdidas orgánicas, y coberturas para cáncer de mama, cáncer de ovario, complicaciones en el embarazo y complicaciones en el recién nacido.',
  },
  {
    question: '¿Vida Mujer incluye ahorro?',
    answer: 'Sí. A partir del 5.º año se entregan porcentajes de la suma asegurada (por ejemplo 5% en los años 5, 7, 9, 11, 13, 15 y 17) y se mantiene la protección por fallecimiento. El plan garantiza el 115% de rendimiento de la suma asegurada al vencimiento. Las primas suelen ser niveladas durante 20 años.',
  },
  {
    question: '¿Qué cubre la protección por cáncer femenino?',
    answer: 'Indemniza un porcentaje de la suma asegurada según el órgano y el estadio: mama maligno 100% o 47% si está localizado, ovario maligno 38%, útero maligno 21% o 12% localizado, trompas de Falopio 12% y tumores benignos de vagina o vulva 9%. Hay carencia de 6 meses, la cobertura llega hasta los 70 años o el fin del periodo de pago, y el pago es en una sola exhibición. Los porcentajes son ilustrativos según la versión de la póliza.',
  },
  {
    question: '¿Hay anticipos por matrimonio, nacimiento o un padecimiento grave?',
    answer: 'Entre el 4.º y el 5.º año puede solicitarse un anticipo del 5% de la suma asegurada por matrimonio o por nacimiento o adopción. El beneficio de Apoyo en Vida anticipa hasta el 25% de la suma asegurada o $700,000 MXN, lo que resulte menor, en padecimientos graves definidos. Los anticipos reducen la suma asegurada en la misma proporción.',
  },
  {
    question: '¿Desde qué edad y en qué moneda se contrata?',
    answer: 'La contratación es de 18 a 55 años, según evaluación. Hay versiones en UDIS o USD, con mínimos de referencia de 10,000 USD o 35,000 UDIS. La asesoría de Ramírez & Plascencia está disponible en todo México, con firma electrónica.',
  },
];

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Seguros de Vida', item: `${site}/seguros-vida` },
    { '@type': 'ListItem', position: 3, name: 'Vida Mujer', item: canonical },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceData)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbData)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqPageSchema(vidaMujerFaqs))} />
  <main class="">
