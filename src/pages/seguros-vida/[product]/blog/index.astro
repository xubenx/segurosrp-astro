---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import BlogCard from '../../../../components/blog/BlogCard.astro';
import { getPostsBySection } from '../../../../lib/blog-collection';
import { SITE_URL } from '../../../../lib/blog';

// La ficha del producto es src/pages/seguros-vida/segubeca.astro. Astro no
// permite una carpeta con el mismo nombre, así que el blog cuelga de [product]
// y getStaticPaths solo publica SeguBeca:
// /seguros-vida/segubeca/blog
export async function getStaticPaths() {
  return [{ params: { product: 'segubeca' } }];
}

export const prerender = true;

const posts = await getPostsBySection('segubeca');
const pageTitle = 'Blog de SeguBeca | Seguro educativo';
const pageDescription =
  'Guías de SeguBeca, el seguro educativo de Seguros Monterrey New York Life: cómo planear la universidad de tus hijos con ahorro, vida e invalidez.';
const canonical = `${SITE_URL}/seguros-vida/segubeca/blog`;
const productUrl = `${SITE_URL}/seguros-vida/segubeca`;
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Blog',
        '@id': `${canonical}#blog`,
        name: 'Blog de SeguBeca',
        description: pageDescription,
        url: canonical,
        inLanguage: 'es-MX',
        about: {
          '@type': 'Service',
          name: 'SeguBeca',
          url: productUrl,
        },
        publisher: { '@id': `${SITE_URL}/#organization` },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
          { '@type': 'ListItem', position: 2, name: 'Seguros de Vida', item: `${SITE_URL}/seguros-vida` },
          { '@type': 'ListItem', position: 3, name: 'SeguBeca', item: productUrl },
          { '@type': 'ListItem', position: 4, name: 'Blog', item: canonical },
        ],
      },
    ],
  })} />
  <Header />
  <main class="pt-24 pb-16">
    <section class="bg-gradient-to-br from-rp-blue via-blue-800 to-rp-light-blue text-white py-14">
      <div class="container mx-auto px-4 max-w-4xl">
        <p class="text-rp-orange font-semibold mb-3">
          <a href="/seguros-vida/segubeca" class="hover:text-yellow-300">SeguBeca</a>
        </p>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Blog de SeguBeca</h1>
        <p class="text-lg text-blue-100 max-w-2xl">
          Cómo funciona el seguro educativo de Seguros Monterrey New York Life para la universidad de tus hijos. Asesoría en todo México, no solo en una ciudad.
        </p>
        <a
          href="/seguros-vida/segubeca#contacto"
          class="inline-block mt-6 bg-rp-orange hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-full transition"
        >
          Cotizar SeguBeca
        </a>
      </div>
    </section>

    <section class="container mx-auto px-4 py-12">
      {posts.length === 0 ? (
        <p class="text-gray-600 text-center py-16">Aún no hay artículos publicados.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>
      )}
    </section>
  </main>
  <Footer />
</Layout>
