rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: leads
    // Document ID: lead id (l_...)
    // Fields:
    //   - id: string (required)
    //   - createdAt: string ISO (required)
    //   - updatedAt: string ISO (required)
    //   - name: string
    //   - email: string
    //   - phone: string
    //   - status: string (nuevo|contactado|seguimiento|agendado|ganado|perdido)
    //   - perfil: string (""|A|B|C)
    //   - source, campaign, type, oferta, diagnostico, puntos, message, notes, pageUrl, raw, telegramMessageId: string
    //   - answers: map<string, string>
    //   - followups: list of { id, at, text, author }
    //
    // Access: only Firebase Admin SDK from the Astro API (Vercel).
    // The browser never talks to Firestore. Prototype: deny all clients.
    // ===============================================================

    function isValidLead() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'createdAt', 'updatedAt', 'status', 'type'])
        && data.id is string
        && data.createdAt is string
        && data.updatedAt is string
        && data.status in ['nuevo', 'contactado', 'seguimiento', 'agendado', 'ganado', 'perdido'];
    }

    match /leads/{leadId} {
      allow read, write: if false;
      allow create, update: if false && isValidLead();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
