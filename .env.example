# Panel /sistema — usuario y contraseña del equipo
SISTEMA_USER=editor
SISTEMA_PASSWORD=cambia-esta-clave
SISTEMA_SECRET=una-cadena-larga-aleatoria

# Publicar artículos en el repo (Vercel redespliega solo)
# Token clásico con scope `repo`, o fine-grained con Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=xubenx/segurosrp-astro
GITHUB_BRANCH=main

# CRM de leads: Cloud Firestore (proyecto seguros-rp, colección `leads`)
FIREBASE_PROJECT_ID=seguros-rp
# JSON completo de la cuenta de servicio (recomendado en Vercel, una sola línea)
FIREBASE_SERVICE_ACCOUNT=
# O, en su lugar:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional: importar la hoja vieja de Google hacia Firestore
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1RMrJ3Tl5xj4XXvzBFWj1mS3fH9FUD9XqD0GO_eGdP-U
GOOGLE_SHEET_NAME=LEADS

# Telegram: el bot SOLO avisa. Para importar el historial del grupo hace falta una cuenta.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generar con: npm run telegram:session
TELEGRAM_SESSION=
